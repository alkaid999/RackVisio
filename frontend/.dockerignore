# 依赖与构建产物（阶段 1 内由 npm ci / npm run build 重新生成）
node_modules/
dist/
dist_bak*/
dist_bak/

# 环境变量与本地配置（含密钥，绝不入镜）
.env
.env.*
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 日志与运行产物
*.log

# IDE / 编辑器
.idea/
.vscode/

# Git 元数据
.git/
.gitignore
